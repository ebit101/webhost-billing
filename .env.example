# Runtime
NODE_ENV=development
WEB_PORT=3000
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
SESSION_TTL_SECONDS=604800
PASSWORD_RESET_TTL_SECONDS=3600
EMAIL_VERIFICATION_TTL_SECONDS=86400
AUTH_RATE_LIMIT_NAMESPACE=development

# Local PostgreSQL — development only
POSTGRES_DB=webhost_billing
POSTGRES_USER=webhost_billing
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://webhost_billing:replace-with-a-local-development-password@127.0.0.1:5432/webhost_billing?schema=public

# Local Redis — development only
REDIS_PASSWORD=replace-with-a-local-development-password
REDIS_PORT=6379
REDIS_URL=redis://:replace-with-a-local-development-password@127.0.0.1:6379/0

# Generate unique values for real environments. Never commit populated .env files.
SESSION_SECRET=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-dedicated-encryption-key
