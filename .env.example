# Runtime
NODE_ENV=development
WEB_PORT=3000
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_ORIGIN=http://localhost:3001
SESSION_TTL_SECONDS=604800
PASSWORD_RESET_TTL_SECONDS=3600
EMAIL_VERIFICATION_TTL_SECONDS=86400
AUTH_RATE_LIMIT_NAMESPACE=development
PAYMENT_PROVIDER_TIMEOUT_MS=10000
HOSTING_PANEL_TIMEOUT_MS=10000

# Sandbox payment providers are disabled until sandbox credentials are added.
# Never put production credentials in this development file.
BKASH_ENABLED=false
BKASH_SANDBOX_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
SSLCOMMERZ_ENABLED=false
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# Local PostgreSQL — development only
POSTGRES_DB=webhost_billing
POSTGRES_USER=webhost_billing
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://webhost_billing:replace-with-a-local-development-password@127.0.0.1:5432/webhost_billing?schema=public

# Local Redis — development only
REDIS_PASSWORD=replace-with-a-local-development-password
REDIS_PORT=6379
REDIS_URL=redis://:replace-with-a-local-development-password@127.0.0.1:6379/0
BULLMQ_PREFIX=webhost-billing
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=25
OUTBOX_LOCK_TIMEOUT_SECONDS=120

# Queued email delivery. Preview writes private .eml files and never sends externally.
EMAIL_TRANSPORT=preview
EMAIL_PUBLIC_WEB_URL=http://localhost:3000
EMAIL_BRAND_NAME=Webhost Billing
EMAIL_BRAND_COLOR=#0891b2
EMAIL_FROM_ADDRESS=no-reply@example.test
EMAIL_FROM_NAME=Webhost Billing
EMAIL_REPLY_TO_ADDRESS=support@example.test
EMAIL_PREVIEW_DIRECTORY=/tmp/webhost-billing-email-preview
EMAIL_WORKER_CONCURRENCY=2
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000

# Generate unique values for real environments. Never commit populated .env files.
SESSION_SECRET=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-dedicated-encryption-key
