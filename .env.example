# Runtime
NODE_ENV=development
WEB_PORT=3000
API_PORT=3001

# Local infrastructure values are activated in Command 2.
DATABASE_URL=postgresql://webhost_billing:replace-me@postgres:5432/webhost_billing
REDIS_URL=redis://redis:6379

# Generate unique values for real environments. Never commit populated .env files.
SESSION_SECRET=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-dedicated-encryption-key
