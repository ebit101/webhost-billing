# Operator-owned configuration. Copy outside the repository with mode 0600.
# Replace the database/project before activation; no secret values belong here.
BACKUP_DATABASE_NAME=REPLACE_BEFORE_ENABLING
BACKUP_POSTGRES_SERVICE=postgres
COMPOSE_PROJECT_NAME=REPLACE_BEFORE_ENABLING
COMPOSE_FILE=/opt/webhost-billing/current/deploy/production/compose.production.yaml
COMPOSE_ENV_FILES=/etc/webhost-billing/application.env
BACKUP_OUTPUT_DIRECTORY=/var/backups/webhost-billing
BACKUP_PASSPHRASE_FILE=/etc/webhost-billing/backup-passphrase
