IMAGE_TAG=local
COMPOSE_PROJECT_NAME=webhost-billing-production
HTTP_PORT=80
HTTPS_PORT=443
BILLING_HOST=billing.example.com
API_HOST=api.billing.example.com
# Public web branding is frozen at image build time; never place secrets here.
NEXT_PUBLIC_BRAND_NAME=Webhost Billing
NEXT_PUBLIC_BRAND_LOGO_PATH=
NEXT_PUBLIC_BRAND_LOGO_WIDTH=285
NEXT_PUBLIC_BRAND_LOGO_HEIGHT=63
NEXT_PUBLIC_BRAND_TAGLINE=
NEXT_PUBLIC_BRAND_CONTACT_EMAIL=
NEXT_PUBLIC_BRAND_CONTACT_PHONE=
NEXT_PUBLIC_BRAND_CONTACT_ADDRESS=
NEXT_PUBLIC_BRAND_WEBSITE=
PRODUCTION_SECRET_DIRECTORY=/srv/webhost-billing/secrets

POSTGRES_DB=webhost_billing
POSTGRES_USER=webhost_billing
BULLMQ_PREFIX=webhost-billing-production

EMAIL_BRAND_NAME=Webhost Billing
EMAIL_BRAND_COLOR="#0891b2"
EMAIL_FROM_ADDRESS=billing@example.com
EMAIL_FROM_NAME=Webhost Billing
EMAIL_REPLY_TO_ADDRESS=support@example.com
EMAIL_WORKER_CONCURRENCY=2
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
