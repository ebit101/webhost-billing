limit_req_zone $binary_remote_addr zone=webhost_billing_staging_auth:10m rate=10r/m;

upstream webhost_billing_staging_web {
    server 127.0.0.1:${STAGING_WEB_PORT};
    keepalive 16;
}

upstream webhost_billing_staging_api {
    server 127.0.0.1:${STAGING_API_PORT};
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${BILLING_HOST};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/webhost-billing-staging/acme;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${BILLING_HOST};

    ssl_certificate /etc/letsencrypt/live/${BILLING_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${BILLING_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:WebhostBillingStagingSSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    server_tokens off;
    client_max_body_size 1m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=()" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header X-Request-ID $request_id always;
    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Permissions-Policy;

    location = /health {
        proxy_pass http://webhost_billing_staging_api;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
    }

    location = /ready {
        proxy_pass http://webhost_billing_staging_api;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
    }

    location = /auth/login {
        limit_req zone=webhost_billing_staging_auth burst=5 nodelay;
        proxy_pass http://webhost_billing_staging_api;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
    }

    location ~ ^/(auth|background-jobs|customers|dashboard|email-notifications|hosting-panel|orders|payment-gateways|payments|products|renewal-automation|reports|services|settings|tickets|observability)(/|$) {
        proxy_pass http://webhost_billing_staging_api;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    location ~ ^/invoices/[^/]+/print/?$ {
        proxy_pass http://webhost_billing_staging_web;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
    }

    location /invoices {
        proxy_pass http://webhost_billing_staging_api;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
    }

    location / {
        proxy_pass http://webhost_billing_staging_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }
}
