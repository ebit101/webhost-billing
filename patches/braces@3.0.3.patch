diff --git a/lib/validate-ast.js b/lib/validate-ast.js
new file mode 100644
index 0000000000000000000000000000000000000000..ade08f3f3d3076655a7de02d94f44815006b0816
--- /dev/null
+++ b/lib/validate-ast.js
@@ -0,0 +1,46 @@
+'use strict';
+
+// Local Webhost Billing mitigation for GHSA-vfj7-8cjw-p6xm. Not an upstream release.
+const MAX_DEPTH = 128;
+const MAX_NODES = 65536;
+const fail = () => {
+  throw new SyntaxError('[braces] AST exceeds safe traversal limits');
+};
+
+// Validate iteratively before any recursive walker, including direct AST callers.
+// Follow only the tree edges; parser-generated prev/parent backlinks are not children.
+const validateParents = ast => {
+  const ancestors = new Set();
+  for (let node = ast; node; node = node.parent) {
+    if (typeof node !== 'object' || ancestors.has(node) || ancestors.size > MAX_DEPTH) fail();
+    ancestors.add(node);
+  }
+};
+
+const validateAst = ast => {
+  const active = new Set();
+  const stack = [{ node: ast, parent: null, depth: 0, index: -1 }];
+  let visits = 0;
+  while (stack.length) {
+    const frame = stack[stack.length - 1];
+    const node = frame.node;
+    if (frame.index === -1) {
+      if (!node || typeof node !== 'object' || frame.depth > MAX_DEPTH ||
+          ++visits > MAX_NODES || active.has(node)) fail();
+      if (node.nodes !== undefined && !Array.isArray(node.nodes)) fail();
+      // Imbalanced parser blocks retain old parent links when their children move.
+      // Those links need bounded, acyclic ancestry, not exact tree-edge identity.
+      validateParents(node);
+      active.add(node);
+      frame.index = 0;
+    }
+    if (node.nodes && frame.index < node.nodes.length) {
+      stack.push({ node: node.nodes[frame.index++], parent: node, depth: frame.depth + 1, index: -1 });
+    } else {
+      active.delete(node);
+      stack.pop();
+    }
+  }
+};
+
+module.exports = { validateAst, MAX_DEPTH };
