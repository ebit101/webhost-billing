* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unified diff context must preserve upstream tabs and empty context lines.
patches/deepmerge@4.3.1.patch whitespace=-blank-at-eol,-space-before-tab

*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.woff binary
*.woff2 binary
