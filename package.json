{
  "name": "webhost-billing",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Open-source billing and service-management system for web-hosting businesses",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:packages": "pnpm --filter @webhost-billing/config build && pnpm --filter @webhost-billing/shared build && pnpm --filter @webhost-billing/database build && pnpm --filter @webhost-billing/queue build",
    "backup:create": "scripts/backups/create-postgres-backup.sh",
    "backup:verify": "scripts/backups/verify-postgres-backup.sh",
    "backup:restore": "scripts/backups/restore-postgres-backup.sh",
    "backup:verify-restore": "scripts/backups/verify-restored-database.sh",
    "backup:test-recovery": "scripts/backups/test-recovery-drill.sh",
    "db:format": "pnpm --filter @webhost-billing/database db:format",
    "db:generate": "pnpm --filter @webhost-billing/database db:generate",
    "db:migrate:deploy": "pnpm --filter @webhost-billing/database db:migrate:deploy",
    "db:migrate:dev": "pnpm --filter @webhost-billing/database db:migrate:dev",
    "db:migrate:status": "pnpm --filter @webhost-billing/database db:migrate:status",
    "db:seed": "pnpm --filter @webhost-billing/database db:seed",
    "db:validate": "pnpm --filter @webhost-billing/database db:validate",
    "db:verify": "pnpm --filter @webhost-billing/database db:verify",
    "docs:links": "node scripts/docs/check-markdown-links.mjs",
    "docs:paths": "node scripts/docs/check-contributor-paths.mjs",
    "docs:issue-forms": "node scripts/docs/check-issue-forms.mjs",
    "docs:demo-assets": "node scripts/docs/check-demo-screenshot-assets.mjs",
    "docs:check": "node scripts/docs/check-documentation.mjs",
    "demo:a11y": "node scripts/demo/manage-demo.mjs a11y",
    "demo:credentials": "node scripts/demo/manage-demo.mjs credentials",
    "demo:doctor": "node scripts/demo/manage-demo.mjs doctor",
    "demo:down": "node scripts/demo/manage-demo.mjs down",
    "demo:logs": "node scripts/demo/manage-demo.mjs logs",
    "demo:reset": "node scripts/demo/manage-demo.mjs reset",
    "demo:screenshots": "node scripts/demo/manage-demo.mjs screenshots",
    "demo:smoke": "node scripts/demo/manage-demo.mjs smoke",
    "demo:status": "node scripts/demo/manage-demo.mjs status",
    "demo:up": "node scripts/demo/manage-demo.mjs up",
    "predev": "pnpm build:packages",
    "production:build": "docker compose --env-file deploy/production/.env.production -f deploy/production/compose.production.yaml --profile tools build",
    "production:config": "docker compose --env-file deploy/production/.env.production -f deploy/production/compose.production.yaml --profile tools config --quiet",
    "production:down": "docker compose --env-file deploy/production/.env.production -f deploy/production/compose.production.yaml down",
    "production:migrate": "docker compose --env-file deploy/production/.env.production -f deploy/production/compose.production.yaml --profile tools run --rm migrate",
    "production:up": "docker compose --env-file deploy/production/.env.production -f deploy/production/compose.production.yaml up --detach --wait",
    "release:source:build": "node scripts/releases/build-source-release.mjs",
    "pretest": "pnpm build:packages",
    "dev": "pnpm --parallel --stream --filter @webhost-billing/api --filter @webhost-billing/web --filter @webhost-billing/worker dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm --filter @webhost-billing/api lint && pnpm --filter @webhost-billing/worker lint && pnpm --filter @webhost-billing/web lint",
    "infra:config": "docker compose config --quiet",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs --follow postgres redis",
    "infra:ps": "docker compose ps",
    "infra:up": "docker compose up --detach --wait postgres redis",
    "test": "pnpm run test:tooling-security && pnpm run test:demo-doctor && pnpm run test:demo-inspection && pnpm run test:demo-reset && pnpm run test:demo-smoke && pnpm run test:demo-assets && pnpm run test:docs-check && pnpm run test:docs-paths && pnpm run test:docs-links && pnpm run test:issue-forms && pnpm -r --if-present test",
    "test:tooling-security": "node --test --test-concurrency=1 scripts/security/tooling-mitigations.test.mjs",
    "test:demo-doctor": "node --test scripts/demo/demo-doctor.test.mjs",
    "test:demo-inspection": "node --test scripts/demo/demo-inspection.test.mjs",
    "test:demo-reset": "node --test scripts/demo/demo-reset.test.mjs",
    "test:demo-smoke": "node --test scripts/demo/demo-smoke.test.mjs",
    "test:demo-assets": "node --test scripts/docs/check-demo-screenshot-assets.test.mjs",
    "test:docs-check": "node --test scripts/docs/check-documentation.test.mjs",
    "test:docs-paths": "node --test scripts/docs/check-contributor-paths.test.mjs",
    "test:docs-links": "node --test scripts/docs/check-markdown-links.test.mjs",
    "test:issue-forms": "node --test scripts/docs/check-issue-forms.test.mjs",
    "pretest:e2e": "pnpm build:packages",
    "test:e2e": "pnpm --filter @webhost-billing/web test:e2e",
    "pretest:invariants": "pnpm build:packages",
    "test:invariants": "pnpm run test:invariants:contracts && pnpm run test:invariants:api-unit && pnpm run test:invariants:api-e2e && pnpm run test:invariants:worker",
    "test:invariants:contracts": "pnpm --filter @webhost-billing/shared test",
    "test:invariants:api-unit": "pnpm --filter @webhost-billing/api exec jest --runInBand --runTestsByPath src/modules/invoices/invoice.service.spec.ts src/modules/payment-gateways/payment-money.spec.ts",
    "test:invariants:api-e2e": "pnpm --filter @webhost-billing/api exec cross-env NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json --runInBand --runTestsByPath test/payment-gateways.e2e-spec.ts test/payments.e2e-spec.ts test/orders.e2e-spec.ts test/invoices.e2e-spec.ts test/services.e2e-spec.ts test/hosting-panels.e2e-spec.ts",
    "test:invariants:worker": "pnpm --filter @webhost-billing/worker exec cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand --runTestsByPath src/renewal/renewal-lifecycle.integration.spec.ts src/renewal/renewal-scheduler.integration.spec.ts",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "cross-env": "10.1.0",
    "js-yaml": "4.3.2",
    "prettier": "^3.9.9",
    "typescript": "^5.9.2"
  }
}
