{
  "name": "webhost-billing",
  "version": "0.1.0",
  "private": true,
  "description": "Private web-hosting billing and service-management system",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:packages": "pnpm --filter @webhost-billing/config build && pnpm --filter @webhost-billing/shared build && pnpm --filter @webhost-billing/database build",
    "db:format": "pnpm --filter @webhost-billing/database db:format",
    "db:generate": "pnpm --filter @webhost-billing/database db:generate",
    "db:migrate:deploy": "pnpm --filter @webhost-billing/database db:migrate:deploy",
    "db:migrate:dev": "pnpm --filter @webhost-billing/database db:migrate:dev",
    "db:migrate:status": "pnpm --filter @webhost-billing/database db:migrate:status",
    "db:seed": "pnpm --filter @webhost-billing/database db:seed",
    "db:validate": "pnpm --filter @webhost-billing/database db:validate",
    "db:verify": "pnpm --filter @webhost-billing/database db:verify",
    "predev": "pnpm build:packages",
    "dev": "pnpm --parallel --stream --filter @webhost-billing/api --filter @webhost-billing/web --filter @webhost-billing/worker dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm --filter @webhost-billing/api lint && pnpm --filter @webhost-billing/worker lint && pnpm --filter @webhost-billing/web lint",
    "infra:config": "docker compose config --quiet",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs --follow postgres redis",
    "infra:ps": "docker compose ps",
    "infra:up": "docker compose up --detach --wait postgres redis",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
