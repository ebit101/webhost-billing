{
  "name": "@webhost-billing/shared",
  "version": "0.1.0-alpha.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "commonjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./currency-arithmetic": {
      "types": "./src/currency-arithmetic.ts",
      "default": "./dist/currency-arithmetic.js"
    },
    "./currency-policy": {
      "types": "./src/currency-policy.ts",
      "default": "./dist/currency-policy.js"
    },
    "./observability": {
      "types": "./src/observability.ts",
      "default": "./dist/observability.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test test/**/*.spec.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.2"
  }
}
