{
  "name": "@webhost-billing/database",
  "version": "0.1.0-alpha.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "commonjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./currency-units": {
      "types": "./src/currency-units.ts",
      "default": "./dist/currency-units.js"
    }
  },
  "scripts": {
    "build": "pnpm db:generate && tsc -p tsconfig.build.json",
    "db:format": "prisma format --config prisma.config.ts",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "db:migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "db:migrate:status": "prisma migrate status --config prisma.config.ts",
    "db:seed": "prisma db seed --config prisma.config.ts",
    "db:validate": "prisma validate --config prisma.config.ts",
    "db:verify": "tsx prisma/verify.ts",
    "typecheck": "pnpm db:generate && tsc -p tsconfig.json --noEmit",
    "test:unit": "tsx --test --test-concurrency=1 test/currency-units.spec.ts",
    "test": "pnpm test:unit && pnpm --filter @webhost-billing/web exec tsx e2e/run-database-tests.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@webhost-billing/shared": "workspace:*",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "tsx": "4.23.12",
    "typescript": "^5.9.2"
  }
}
