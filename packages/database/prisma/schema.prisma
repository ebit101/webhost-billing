generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// Empty inert identity storage. Explicit operator fixtures are not active placement authority.
model CurrencyInstallation {
  id                    Int                             @id @db.SmallInt
  installationId        String                          @unique(map: "currency_installations_installation_id_key") @map("installation_id") @db.Uuid
  createdAt             DateTime                        @map("created_at") @db.Timestamptz(3)
  domains               CurrencyExecutionDomain[]
  selectionIntents      CurrencySelectionIntent[]
  authorizationEvidence CurrencyAuthorizationEvidence[]

  @@map("currency_installations")
}

// Historical placement facts only: no current selector, pin, defaults or runtime consumer.
model CurrencyExecutionDomain {
  id                      String                          @id @db.Uuid
  installationId          String                          @map("installation_id") @db.Uuid
  databaseName            String                          @map("database_name") @db.VarChar(63)
  schemaName              String                          @map("schema_name") @db.VarChar(63)
  placementManifestDigest String                          @map("placement_manifest_digest") @db.VarChar(64)
  createdAt               DateTime                        @map("created_at") @db.Timestamptz(3)
  installation            CurrencyInstallation            @relation(fields: [installationId], references: [installationId], onDelete: Restrict, onUpdate: Restrict, map: "currency_execution_domains_installation_fkey")
  selectionIntents        CurrencySelectionIntent[]
  authorizationEvidence   CurrencyAuthorizationEvidence[]

  @@unique([installationId, id], map: "currency_execution_domains_installation_id_id_key")
  @@map("currency_execution_domains")
}

// Complete unused policy evidence, never an active installation pointer.
model CurrencyPolicyRevision {
  revision        String                    @id @db.VarChar(64)
  policy          Json                      @db.JsonB
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  controls        CurrencyControl[]         @relation("SelectedCurrencyPolicy")
  expectedIntents CurrencySelectionIntent[] @relation("ExpectedIntentPolicy")
  proposedIntents CurrencySelectionIntent[] @relation("ProposedIntentPolicy")

  @@map("currency_policy_revisions")
}

// Unused immutable version facts, not an enabled registry or a current pointer.
model CurrencyUnitDefinition {
  code              String            @db.VarChar(3)
  metadataVersion   String            @map("metadata_version") @db.VarChar(64)
  minorUnitExponent Int               @map("minor_unit_exponent") @db.SmallInt
  provenance        String            @db.VarChar(256)
  status            String            @db.VarChar(10)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  baseControls      CurrencyControl[] @relation("CurrencyControlBaseUnit")

  @@id([code, metadataVersion], map: "currency_unit_definitions_pkey")
  @@map("currency_unit_definitions")
}

// Unused staging only. NULL history means unknown, never history-free.
model CurrencyControl {
  id                     Int                     @id @db.SmallInt
  generation             BigInt                  @default(0)
  selectedPolicyRevision String?                 @map("selected_policy_revision") @db.VarChar(64)
  historyLatched         Boolean?                @map("history_latched")
  baseCode               String?                 @map("base_code") @db.VarChar(3)
  baseMetadataVersion    String?                 @map("base_metadata_version") @db.VarChar(64)
  baseMinorUnitExponent  Int?                    @map("base_minor_unit_exponent") @db.SmallInt
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  selectedPolicy         CurrencyPolicyRevision? @relation("SelectedCurrencyPolicy", fields: [selectedPolicyRevision], references: [revision], onDelete: Restrict, onUpdate: Restrict)
  baseUnit               CurrencyUnitDefinition? @relation("CurrencyControlBaseUnit", fields: [baseCode, baseMetadataVersion], references: [code, metadataVersion], onDelete: Restrict, onUpdate: Restrict)

  @@map("currency_controls")
}

// Closed historical public factor identities, never current enrollment or approval.
model CurrencyAuthorizationEvidence {
  id                String                  @id @db.Uuid
  executionDomainId String                  @map("execution_domain_id") @db.Uuid
  actorUserId       String                  @map("actor_user_id") @db.Uuid
  adminProfileId    String                  @map("admin_profile_id") @db.Uuid
  sessionId         String                  @map("session_id") @db.Uuid
  authEpoch         BigInt                  @map("auth_epoch")
  credentialId      String                  @map("credential_id") @db.Uuid
  recoverySetEpoch  BigInt                  @map("recovery_set_epoch")
  factorKind        String                  @map("factor_kind") @db.VarChar(8)
  recoveryCodeId    String?                 @map("recovery_code_id") @db.Uuid
  installationId    String                  @map("installation_id") @db.Uuid
  createdAt         DateTime                @map("created_at") @db.Timestamptz(3)
  installation      CurrencyInstallation    @relation(fields: [installationId], references: [installationId], onDelete: Restrict, onUpdate: Restrict, map: "currency_authorization_evidence_installation_fkey")
  executionDomain   CurrencyExecutionDomain @relation(fields: [installationId, executionDomainId], references: [installationId, id], onDelete: Restrict, onUpdate: Restrict, map: "currency_authorization_evidence_domain_fkey")
  actor             User                    @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "currency_authorization_evidence_actor_fkey")
  adminProfile      AdminProfile            @relation(fields: [adminProfileId, actorUserId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict, map: "currency_authorization_evidence_profile_owner_fkey")
  session           AuthSession             @relation(fields: [sessionId, actorUserId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict, map: "currency_authorization_evidence_session_owner_fkey")

  @@map("currency_authorization_evidence")
}

// Empty and unconditionally write-blocked. Facts are not a reservation or approval.
model CurrencySelectionIntent {
  installationId     String                  @map("installation_id") @db.Uuid
  requestKeyUuid     String                  @map("request_key_uuid") @db.Uuid
  executionDomainId  String                  @map("execution_domain_id") @db.Uuid
  actorUserId        String                  @map("actor_user_id") @db.Uuid
  sessionId          String                  @map("session_id") @db.Uuid
  requestKeyText     String                  @map("request_key_text") @db.Text
  action             String                  @db.VarChar(10)
  expectedRevision   String?                 @map("expected_revision") @db.VarChar(64)
  expectedGeneration BigInt                  @map("expected_generation")
  proposedRevision   String                  @map("proposed_revision") @db.VarChar(64)
  canonicalText      String                  @map("canonical_text") @db.Text
  stableIntentDigest String                  @map("stable_intent_digest") @db.VarChar(64)
  installation       CurrencyInstallation    @relation(fields: [installationId], references: [installationId], onDelete: Restrict, onUpdate: Restrict, map: "currency_selection_intents_installation_fkey")
  executionDomain    CurrencyExecutionDomain @relation(fields: [installationId, executionDomainId], references: [installationId, id], onDelete: Restrict, onUpdate: Restrict, map: "currency_selection_intents_domain_fkey")
  actor              User                    @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "currency_selection_intents_actor_fkey")
  session            AuthSession             @relation(fields: [sessionId, actorUserId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict, map: "currency_selection_intents_session_owner_fkey")
  expectedPolicy     CurrencyPolicyRevision? @relation("ExpectedIntentPolicy", fields: [expectedRevision], references: [revision], onDelete: Restrict, onUpdate: Restrict, map: "currency_selection_intents_expected_policy_fkey")
  proposedPolicy     CurrencyPolicyRevision  @relation("ProposedIntentPolicy", fields: [proposedRevision], references: [revision], onDelete: Restrict, onUpdate: Restrict, map: "currency_selection_intents_proposed_policy_fkey")

  @@id([installationId, requestKeyUuid], map: "currency_selection_intents_pkey")
  @@map("currency_selection_intents")
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum StaffRole {
  FULL_ADMINISTRATOR
  BILLING_OPERATOR
  SUPPORT_OPERATOR
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum BillingPeriod {
  ONE_TIME
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  BIENNIAL
  TRIENNIAL
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
  FAILED
}

enum ServiceStatus {
  PENDING
  PROVISIONING
  ACTIVE
  SUSPENDED
  PROVISION_FAILED
  CANCELLED
  TERMINATED
}

enum ServerStatus {
  ACTIVE
  MAINTENANCE
  DISABLED
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentKind {
  CHARGE
  REFUND
  REVERSAL
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PaymentEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum TicketStatus {
  OPEN
  WAITING_FOR_CUSTOMER
  WAITING_FOR_STAFF
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketMessageKind {
  CUSTOMER
  ADMIN
  SYSTEM
}

enum EmailStatus {
  QUEUED
  SENDING
  SENT
  FAILED
}

enum EmailAttemptStatus {
  STARTED
  SENT
  FAILED
  INCONSISTENT
}

enum AutomationStatus {
  RUNNING
  SUCCEEDED
  PARTIALLY_SUCCEEDED
  FAILED
  SKIPPED
}

enum HostingPanelOperationType {
  TEST_CONNECTION
  CREATE_ACCOUNT
  GET_ACCOUNT
  SUSPEND_ACCOUNT
  UNSUSPEND_ACCOUNT
  CHANGE_PACKAGE
  CHANGE_PASSWORD
  GENERATE_LOGIN_URL
  TERMINATE_ACCOUNT
}

enum HostingPanelOperationStatus {
  RUNNING
  SUCCEEDED
  FAILED
  INCONSISTENT
}

enum HostingPanelErrorKind {
  TEMPORARY
  PERMANENT
  INCONSISTENT
}

enum SettingCategory {
  BUSINESS
  BILLING
  AUTOMATION
  EMAIL
  INTEGRATION
  SECURITY
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

model User {
  id                            String                          @id @default(uuid()) @db.Uuid
  email                         String                          @unique(map: "users_email_key") @db.VarChar(320)
  passwordHash                  String?                         @map("password_hash") @db.VarChar(255)
  role                          UserRole
  status                        UserStatus                      @default(PENDING_VERIFICATION)
  emailVerifiedAt               DateTime?                       @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt                   DateTime?                       @map("last_login_at") @db.Timestamptz(3)
  createdAt                     DateTime                        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                     DateTime?                       @map("deleted_at") @db.Timestamptz(3)
  customer                      Customer?
  adminProfile                  AdminProfile?
  paymentsCreated               Payment[]                       @relation("PaymentCreatedBy")
  paymentsReviewed              Payment[]                       @relation("PaymentReviewedBy")
  ticketsAssigned               Ticket[]                        @relation("TicketAssignedAdmin")
  ticketMessages                TicketMessage[]
  activityLogs                  ActivityLog[]                   @relation("ActivityActor")
  settingsUpdated               Setting[]                       @relation("SettingUpdatedBy")
  integrationCredentialsUpdated IntegrationCredential[]         @relation("IntegrationCredentialUpdatedBy")
  servicesTerminated            Service[]                       @relation("ServiceTerminatedBy")
  hostingPanelOperations        HostingPanelOperation[]         @relation("HostingOperationRequestedBy")
  authSessions                  AuthSession[]
  currencySelectionIntents      CurrencySelectionIntent[]
  currencyAuthorizationEvidence CurrencyAuthorizationEvidence[]
  adminTotpCredential           AdminTotpCredential?
  adminLoginChallenges          AdminLoginChallenge[]
  passwordResetTokens           PasswordResetToken[]
  emailVerificationTokens       EmailVerificationToken[]
  notificationPreference        NotificationPreference?
  notifications                 NotificationEntry[]

  @@index([role, status], map: "users_role_status_idx")
  @@index([deletedAt], map: "users_deleted_at_idx")
  @@map("users")
}

model NotificationEpoch {
  id        String   @id @db.VarChar(16)
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(3)

  @@map("notification_epochs")
}

model NotificationSource {
  key       String   @id @db.VarChar(191)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("notification_sources")
}

model NotificationPreference {
  userId          String   @id @map("user_id") @db.Uuid
  whatsAppEnabled Boolean  @default(true) @map("whatsapp_enabled")
  phoneCiphertext String?  @map("phone_ciphertext") @db.Text
  phoneLastFour   String?  @map("phone_last_four") @db.VarChar(4)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("notification_preferences")
}

model NotificationEntry {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  key          String    @db.VarChar(80)
  sourceKey    String    @map("source_key") @db.VarChar(191)
  channel      String    @db.VarChar(16)
  status       String    @default("DISABLED") @db.VarChar(16)
  attemptCount Int       @default(0) @map("attempt_count")
  failureCode  String?   @map("failure_code") @db.VarChar(64)
  metadata     Json?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(3)
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([sourceKey, userId, key, channel], map: "notifications_source_recipient_key")
  @@index([userId, createdAt, id], map: "notifications_user_created_idx")
  @@index([status, createdAt], map: "notifications_status_created_idx")
  @@map("notification_entries")
}

model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @unique(map: "customers_user_id_key") @map("user_id") @db.Uuid
  customerNumber String         @unique(map: "customers_number_key") @map("customer_number") @db.VarChar(32)
  status         CustomerStatus @default(ACTIVE)
  firstName      String         @map("first_name") @db.VarChar(100)
  lastName       String         @map("last_name") @db.VarChar(100)
  companyName    String?        @map("company_name") @db.VarChar(200)
  phone          String?        @db.VarChar(32)
  addressLine1   String         @map("address_line_1") @db.VarChar(200)
  addressLine2   String?        @map("address_line_2") @db.VarChar(200)
  city           String         @db.VarChar(100)
  region         String?        @db.VarChar(100)
  postalCode     String?        @map("postal_code") @db.VarChar(32)
  countryCode    String         @map("country_code") @db.Char(2)
  taxIdentifier  String?        @map("tax_identifier") @db.VarChar(64)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(3)
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orders         Order[]
  services       Service[]
  invoices       Invoice[]
  tickets        Ticket[]
  emailLogs      EmailLog[]

  @@index([status, deletedAt], map: "customers_status_deleted_at_idx")
  @@index([lastName, firstName], map: "customers_name_idx")
  @@map("customers")
}

model AdminProfile {
  id                            String                          @id @default(uuid()) @db.Uuid
  userId                        String                          @unique(map: "admin_profiles_user_id_key") @map("user_id") @db.Uuid
  displayName                   String                          @map("display_name") @db.VarChar(150)
  jobTitle                      String?                         @map("job_title") @db.VarChar(100)
  isSuperAdmin                  Boolean                         @default(false) @map("is_super_admin")
  staffRole                     StaffRole                       @default(FULL_ADMINISTRATOR) @map("staff_role")
  createdAt                     DateTime                        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                          User                            @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currencyAuthorizationEvidence CurrencyAuthorizationEvidence[]

  @@unique([id, userId], map: "admin_profiles_id_user_id_key")
  @@map("admin_profiles")
}

model AuthSession {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  tokenHash           String    @unique(map: "auth_sessions_token_hash_key") @map("token_hash") @db.Char(64)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt          DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason       String?   @map("revoked_reason") @db.VarChar(64)
  ipAddressHash       String?   @map("ip_address_hash") @db.Char(64)
  userAgent           String?   @map("user_agent") @db.VarChar(512)
  twoFactorVerifiedAt DateTime? @map("two_factor_verified_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user                User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  currencySelectionIntents      CurrencySelectionIntent[]
  currencyAuthorizationEvidence CurrencyAuthorizationEvidence[]

  @@unique([id, userId], map: "auth_sessions_id_user_id_key")
  @@index([userId, revokedAt, expiresAt], map: "auth_sessions_user_active_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@map("auth_sessions")
}

model AdminTotpCredential {
  id               String              @id @default(uuid()) @db.Uuid
  userId           String              @unique(map: "admin_totp_credentials_user_id_key") @map("user_id") @db.Uuid
  secretCiphertext String              @map("secret_ciphertext") @db.Text
  keyVersion       String              @map("key_version") @db.VarChar(64)
  enabledAt        DateTime?           @map("enabled_at") @db.Timestamptz(3)
  lastUsedTimeStep BigInt?             @map("last_used_time_step")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recoveryCodes    AdminRecoveryCode[]

  @@index([enabledAt], map: "admin_totp_credentials_enabled_at_idx")
  @@map("admin_totp_credentials")
}

model AdminRecoveryCode {
  id           String              @id @default(uuid()) @db.Uuid
  credentialId String              @map("credential_id") @db.Uuid
  codeHash     String              @unique(map: "admin_recovery_codes_hash_key") @map("code_hash") @db.Char(64)
  usedAt       DateTime?           @map("used_at") @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  credential   AdminTotpCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([credentialId, usedAt], map: "admin_recovery_codes_credential_used_idx")
  @@map("admin_recovery_codes")
}

model AdminLoginChallenge {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique(map: "admin_login_challenges_token_hash_key") @map("token_hash") @db.Char(64)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt         DateTime? @map("used_at") @db.Timestamptz(3)
  failedAttempts Int       @default(0) @map("failed_attempts")
  ipAddressHash  String    @map("ip_address_hash") @db.Char(64)
  userAgent      String?   @map("user_agent") @db.VarChar(512)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, usedAt, expiresAt], map: "admin_login_challenges_user_active_idx")
  @@index([expiresAt], map: "admin_login_challenges_expires_at_idx")
  @@map("admin_login_challenges")
}

model PasswordResetToken {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  tokenHash          String    @unique(map: "password_reset_tokens_hash_key") @map("token_hash") @db.Char(64)
  deliveryCiphertext String    @map("delivery_ciphertext") @db.Text
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt             DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user               User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, usedAt, expiresAt], map: "password_reset_tokens_user_active_idx")
  @@index([expiresAt], map: "password_reset_tokens_expires_at_idx")
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  tokenHash          String    @unique(map: "email_verification_tokens_hash_key") @map("token_hash") @db.Char(64)
  deliveryCiphertext String    @map("delivery_ciphertext") @db.Text
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt             DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user               User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, usedAt, expiresAt], map: "email_verification_tokens_user_active_idx")
  @@index([expiresAt], map: "email_verification_tokens_expires_at_idx")
  @@map("email_verification_tokens")
}

model ProductGroup {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @unique(map: "product_groups_name_key") @db.VarChar(160)
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  products     Product[]

  @@index([displayOrder, name], map: "product_groups_order_idx")
  @@map("product_groups")
}

model Product {
  groupId                  String?        @map("group_id") @db.Uuid
  group                    ProductGroup?  @relation(fields: [groupId], references: [id], onDelete: Restrict)
  kind                     ProductKind    @default(HOSTING)
  id                       String         @id @default(uuid()) @db.Uuid
  slug                     String         @unique(map: "products_slug_key") @db.VarChar(120)
  name                     String         @db.VarChar(160)
  description              String?        @db.Text
  status                   ProductStatus  @default(DRAFT)
  publicVisible            Boolean        @default(false) @map("public_visible")
  displayOrder             Int            @default(0) @map("display_order")
  hostingPackageIdentifier String?        @map("hosting_package_identifier") @db.VarChar(191)
  storageFeature           String?        @map("storage_feature") @db.VarChar(80)
  websiteFeature           String?        @map("website_feature") @db.VarChar(80)
  emailFeature             String?        @map("email_feature") @db.VarChar(80)
  bandwidthFeature         String?        @map("bandwidth_feature") @db.VarChar(80)
  provisioningAdapter      String?        @map("provisioning_adapter") @db.VarChar(64)
  provisioningConfig       Json?          @map("provisioning_config")
  createdAt                DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                DateTime?      @map("deleted_at") @db.Timestamptz(3)
  prices                   ProductPrice[]
  orderItems               OrderItem[]
  services                 Service[]

