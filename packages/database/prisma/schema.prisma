model EmailAttempt {
  id                String             @id @default(uuid()) @db.Uuid
  emailLogId        String             @map("email_log_id") @db.Uuid
  attemptNumber     Int                @map("attempt_number")
  status            EmailAttemptStatus @default(STARTED)
  provider          String             @db.VarChar(64)
  providerMessageId String?            @map("provider_message_id") @db.VarChar(191)
  failureKind       String?            @map("failure_kind") @db.VarChar(20)
  failureCode       String?            @map("failure_code") @db.VarChar(80)
  startedAt         DateTime           @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt       DateTime?          @map("completed_at") @db.Timestamptz(3)
  emailLog          EmailLog           @relation(fields: [emailLogId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([emailLogId, attemptNumber], map: "email_attempts_log_attempt_key")
  @@index([status, startedAt], map: "email_attempts_status_started_at_idx")
  @@map("email_attempts")
}

model ActivityLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  action        String   @db.VarChar(120)
  entityType    String   @map("entity_type") @db.VarChar(80)
  entityId      String?  @map("entity_id") @db.Uuid
  correlationId String?  @map("correlation_id") @db.Uuid
  metadata      Json?
  ipAddressHash String?  @map("ip_address_hash") @db.Char(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor         User?    @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([actorUserId, createdAt], map: "activity_logs_actor_created_at_idx")
  @@index([entityType, entityId, createdAt], map: "activity_logs_entity_created_at_idx")
  @@index([createdAt], map: "activity_logs_created_at_idx")
  @@map("activity_logs")
}

model AutomationRun {
  id                     String                  @id @default(uuid()) @db.Uuid
  jobName                String                  @map("job_name") @db.VarChar(100)
  idempotencyKey         String                  @unique(map: "automation_runs_idempotency_key") @map("idempotency_key") @db.VarChar(191)
  status                 AutomationStatus        @default(RUNNING)
  startedAt              DateTime                @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt            DateTime?               @map("completed_at") @db.Timestamptz(3)
  processedCount         Int                     @default(0) @map("processed_count")
  succeededCount         Int                     @default(0) @map("succeeded_count")
  failedCount            Int                     @default(0) @map("failed_count")
  errorSummary           String?                 @map("error_summary") @db.Text
  metadata               Json?
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  hostingPanelOperations HostingPanelOperation[]

  @@index([jobName, startedAt], map: "automation_runs_job_started_at_idx")
  @@index([status, startedAt], map: "automation_runs_status_started_at_idx")
  @@map("automation_runs")
}

model Setting {
  id              String          @id @default(uuid()) @db.Uuid
  key             String          @unique(map: "settings_key_key") @db.VarChar(120)
  category        SettingCategory
  value           Json
  description     String?         @db.VarChar(255)
  updatedByUserId String?         @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy       User?           @relation("SettingUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([category], map: "settings_category_idx")
  @@map("settings")
}

model IntegrationCredential {
  id               String   @id @default(uuid()) @db.Uuid
  providerKey      String   @unique(map: "integration_credentials_provider_key_key") @map("provider_key") @db.VarChar(64)
  ciphertext       String   @db.Text
  keyVersion       String   @map("key_version") @db.VarChar(64)
  maskedIdentifier String   @map("masked_identifier") @db.VarChar(200)
  updatedByUserId  String   @map("updated_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy        User     @relation("IntegrationCredentialUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([updatedByUserId], map: "integration_credentials_updated_by_user_id_idx")
  @@map("integration_credentials")
}

model OutboxEvent {
  id             String       @id @default(uuid()) @db.Uuid
  aggregateType  String       @map("aggregate_type") @db.VarChar(80)
  aggregateId    String       @map("aggregate_id") @db.Uuid
  eventType      String       @map("event_type") @db.VarChar(120)
  idempotencyKey String       @unique(map: "outbox_events_idempotency_key") @map("idempotency_key") @db.VarChar(191)
  payload        Json
  status         OutboxStatus @default(PENDING)
  attemptCount   Int          @default(0) @map("attempt_count")
  availableAt    DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedAt       DateTime?    @map("locked_at") @db.Timestamptz(3)
  lockedBy       String?      @map("locked_by") @db.VarChar(120)
  publishedAt    DateTime?    @map("published_at") @db.Timestamptz(3)
  lastError      String?      @map("last_error") @db.Text
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  emailLog       EmailLog?

  @@index([status, availableAt], map: "outbox_events_dispatch_idx")
  @@index([aggregateType, aggregateId, createdAt], map: "outbox_events_aggregate_idx")
  @@map("outbox_events")
}

enum ProductKind {
  HOSTING
  DOMAIN
}

model RegistrarAccount {
  id            String   @id @default(uuid()) @db.Uuid
  provider      String   @default("stargate") @db.VarChar(32)
  mode          String   @default("FAKE") @db.VarChar(16)
  enabled       Boolean  @default(false)
  configuration Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("registrar_accounts")
}

model RegistrarCredential {
  id         String   @id @default(uuid()) @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  version    Int
  ciphertext String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([accountId, version])
  @@map("registrar_credentials")
}

model DomainOffer {
  id          String @id @default(uuid()) @db.Uuid
  accountId   String @map("account_id") @db.Uuid
  productId   String @map("product_id") @db.Uuid
  priceId     String @map("price_id") @db.Uuid
  tld         String @db.VarChar(8)
  nameservers Json

  @@unique([accountId, tld])
  @@unique([id, accountId])
  @@map("domain_offers")
}

model DomainQuote {
  id                String   @id @default(uuid()) @db.Uuid
  customerId        String   @map("customer_id") @db.Uuid
  accountId         String   @map("account_id") @db.Uuid
  offerId           String   @map("offer_id") @db.Uuid
  domainName        String   @map("domain_name") @db.VarChar(253)
  sellingAmount     BigInt   @map("selling_amount")
  costAmount        BigInt   @map("cost_amount")
  costCurrency      String   @map("cost_currency") @db.Char(3)
  contactCiphertext String   @map("contact_ciphertext") @db.Text
  fingerprint       String   @db.Char(64)
  nameservers       Json
  agreement         String   @db.VarChar(64)
  selectionSnapshot Json?    @map("selection_snapshot")
  offlineConsent    Json?    @map("offline_consent")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(3)

  @@unique([id, customerId, accountId])
  @@index([customerId, createdAt])
  @@map("domain_quotes")
}

model Domain {
  id                       String    @id @default(uuid()) @db.Uuid
  quoteId                  String    @unique @map("quote_id") @db.Uuid
  customerId               String    @map("customer_id") @db.Uuid
  accountId                String    @map("account_id") @db.Uuid
  executionAccountId       String?   @map("execution_account_id") @db.Uuid
  orderItemId              String    @unique @map("order_item_id") @db.Uuid
  invoiceId                String    @unique @map("invoice_id") @db.Uuid
  domainName               String    @unique @map("domain_name") @db.VarChar(253)
  submissionKey            String    @unique @map("submission_key") @db.Uuid
  state                    String    @default("AWAITING_PAYMENT") @db.VarChar(32)
  verification             String    @default("Pending") @db.VarChar(32)
  providerOrderId          String?   @map("provider_order_id") @db.VarChar(64)
  expiresAt                DateTime? @map("expires_at") @db.Timestamptz(3)
  autoRenew                Boolean   @default(false) @map("auto_renew")
  managementSnapshot       Json?     @map("management_snapshot")
  currentContactCiphertext String?   @map("current_contact_ciphertext") @db.Text
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([executionAccountId, providerOrderId])
  @@unique([id, customerId, accountId])
  @@index([accountId, providerOrderId])
  @@index([customerId, createdAt])
  @@map("domains")
}

model RegistrarOperation {
  id                      String    @id @default(uuid()) @db.Uuid
  domainId                String    @unique @map("domain_id") @db.Uuid
  customerId              String    @map("customer_id") @db.Uuid
  accountId               String    @map("account_id") @db.Uuid
  credentialId            String    @map("credential_id") @db.Uuid
  selectedAccountId       String?   @map("selected_account_id") @db.Uuid
  selectedCredentialId    String?   @map("selected_credential_id") @db.Uuid
  selectionFingerprint    String?   @map("selection_fingerprint") @db.Char(64)
  actorUserId             String    @map("actor_user_id") @db.Uuid
  costCeiling             BigInt    @map("cost_ceiling")
  priceChangeRiskAccepted Boolean   @default(false) @map("price_change_risk_accepted")
  claimedAt               DateTime? @map("claimed_at") @db.Timestamptz(3)
  nextPollAt              DateTime  @default(now()) @map("next_poll_at") @db.Timestamptz(3)
  pollCount               Int       @default(0) @map("poll_count")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("registrar_operations")
}

model RegistrarEvidence {
  id          String   @id @default(uuid()) @db.Uuid
  operationId String   @map("operation_id") @db.Uuid
  code        String   @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([operationId, createdAt])
  @@map("registrar_evidence")
}

// A claimed creation without a verified ID is unresolved, never permission to retry.
model DomainAction {
  id                String    @id @default(uuid()) @db.Uuid
  domainId          String    @map("domain_id") @db.Uuid
  accountId         String    @map("account_id") @db.Uuid
  customerId        String    @map("customer_id") @db.Uuid
  credentialId      String    @map("credential_id") @db.Uuid
  actorUserId       String    @map("actor_user_id") @db.Uuid
  kind              String    @db.VarChar(16)
  payloadCiphertext String    @map("payload_ciphertext") @db.Text
  invoiceId         String?   @map("invoice_id") @db.Uuid
  state             String    @default("REQUESTED") @db.VarChar(32)
  claimedAt         DateTime? @map("claimed_at") @db.Timestamptz(3)
  contactClaimedAt  DateTime? @map("contact_claimed_at") @db.Timestamptz(3)
  submittedAt       DateTime? @map("submitted_at") @db.Timestamptz(3)
  remoteContactId   String?   @map("remote_contact_id") @db.VarChar(64)
  nextPollAt        DateTime  @default(now()) @map("next_poll_at") @db.Timestamptz(3)
  pollCount         Int       @default(0) @map("poll_count")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([domainId, createdAt])
  @@map("domain_actions")
}

model RegistrarPreparation {
  id                String    @id @default(uuid()) @db.Uuid
  accountId         String    @map("account_id") @db.Uuid
  customerId        String    @map("customer_id") @db.Uuid
  fingerprint       String    @db.Char(64)
  operationId       String    @map("operation_id") @db.Uuid
  customerClaimedAt DateTime? @map("customer_claimed_at") @db.Timestamptz(3)
  remoteCustomerId  String?   @map("remote_customer_id") @db.VarChar(64)
  contactClaimedAt  DateTime? @map("contact_claimed_at") @db.Timestamptz(3)
  remoteContactId   String?   @map("remote_contact_id") @db.VarChar(64)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([accountId, customerId, fingerprint])
  @@index([accountId, customerId])
  @@map("registrar_preparations")
}

model RegistrarMapping {
  id               String @id @default(uuid()) @db.Uuid
  accountId        String @map("account_id") @db.Uuid
  customerId       String @map("customer_id") @db.Uuid
  fingerprint      String @db.Char(64)
  remoteCustomerId String @map("remote_customer_id") @db.VarChar(64)
  remoteContactId  String @map("remote_contact_id") @db.VarChar(64)

  @@unique([accountId, customerId, fingerprint])
  @@unique([accountId, remoteCustomerId, remoteContactId])
  @@map("registrar_mappings")
}

// Fictional provider-side ledger survives lost responses; never stores real credentials.
model FakeRegistrarRegistration {
  id          String   @id @default(uuid()) @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  domainName  String   @map("domain_name") @db.VarChar(253)
  operationId String   @unique @map("operation_id") @db.Uuid
  state       String   @db.VarChar(32)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@unique([accountId, domainName])
  @@map("fake_registrar_registrations")
}

model RegistrarProfile {
  accountId           String  @id @map("account_id") @db.Uuid
  name                String  @db.VarChar(100)
  isDefault           Boolean @default(false) @map("is_default")
  nativeCostConfirmed Boolean @default(false) @map("native_cost_confirmed")

  @@map("registrar_profiles")
}

model DomainCatalogueTld {
  id                   String  @id @default(uuid()) @db.Uuid
  tld                  String  @unique @db.VarChar(50)
  productId            String  @map("product_id") @db.Uuid
  registrationPriceId  String? @map("registration_price_id") @db.Uuid
  renewalAmount        BigInt? @map("renewal_amount")
  preferredRegistrarId String? @map("preferred_registrar_id") @db.Uuid
  enabled              Boolean @default(false)
  featured             Boolean @default(false)
  displayOrder         Int     @default(0) @map("display_order")
  revision             Int     @default(1)

  @@map("domain_catalogue_tlds")
}
